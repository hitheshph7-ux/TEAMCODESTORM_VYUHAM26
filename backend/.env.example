# ── VYUHAM Environment Configuration ──────────────────────────────────────────
# Copy this file to .env and fill in the values

# Application
APP_NAME=VYUHAM
APP_VERSION=1.0.0
DEBUG=false

# Database (SQLite - default path is ./vyuham.db relative to backend/)
DATABASE_URL=sqlite:///./vyuham.db

# Anthropic Claude API (optional - required only for AI mode)
# Leave blank to run in DEMO mode without API calls
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Execution Mode: "demo" (no API key needed) or "ai" (requires ANTHROPIC_API_KEY)
EXECUTION_MODE=demo

# CORS Origins for the React frontend
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Retry configuration
MAX_RETRY_ATTEMPTS=3
